@inproceedings{zhang2026vcagent,
  title     = {VC-Agent: An Interactive Agent for Customized Video Dataset Collection},
  author    = {Zhang, Yidan and Xu, Mutian and Hao, Yiming and Zhou, Kun and Chang, Jiahao and Liu, Xiaoqiang and Wan, Pengfei and Fu, Hongbo and Han, Xiaoguang},
  booktitle = {ACM International Conference on Multimedia (ACM MM)},
  year      = {2026},
  abbr      = {ACM MM},
  selected  = {true},
  arxiv     = {2509.21291},
  doi       = {10.1145/3767308.3835241},
  website   = {https://allenyidan.github.io/vcagent_page/},
  abstract  = {A customized video dataset is hard to scale, because the requirements rarely fit in a single query. VC-Agent turns a rough request and a few rounds of feedback into an updatable filtering policy, using template-based acceptance and attribute-aware rejection. With five stacked requirements, average IoU is 49.2, against 31.1 for LLaVA-OneVision-7B. In a user study the agent collected 335K videos at 84--92\% judged quality.}
}

@inproceedings{yu2023mvimgnet,
  title      = {MVImgNet: A Large-scale Dataset of Multi-view Images},
  author     = {Yu, Xianggang and Xu, Mutian and Zhang, Yidan and Liu, Haolin and Ye, Chongjie and Wu, Yushuang and Yan, Zizheng and Zhu, Chenming and Xiong, Zhangyang and Liang, Tianyou and Chen, Guanying and Cui, Shuguang and Han, Xiaoguang},
  booktitle  = {IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year       = {2023},
  abbr       = {CVPR},
  selected   = {true},
  website    = {https://gaplab.cuhk.edu.cn/projects/MVImgNet/},
  annotation = {* equal technical contribution},
  abstract   = {3D learning has no ImageNet-scale source of real multi-view images, because scanned geometry is costly to collect. MVImgNet provides 6.5M frames from 219,188 videos across 238 classes, with masks, cameras, and point clouds. The data supports view-consistent recognition and real-world 3D object classification, and received the CCF CAD\&CG 2023 Open-source Dataset of the Year.}
}

@inproceedings{chang2026reconviagen,
  title      = {ReconViaGen: Towards Accurate Multi-view 3D Object Reconstruction via Generation},
  author     = {Chang, Jiahao and Ye, Chongjie and Wu, Yushuang and Chen, Yuantao and Zhang, Yidan and Luo, Zhongjin and Li, Chenghong and Zhi, Yihao and Han, Xiaoguang},
  booktitle  = {International Conference on Learning Representations (ICLR)},
  year       = {2026},
  abbr       = {ICLR},
  selected   = {false},
  arxiv      = {2510.23306},
  website    = {https://jiahao620.github.io/reconviagen/},
  annotation = {* equal contribution: Jiahao Chang and Chongjie Ye},
  abstract   = {When input views barely overlap, reconstruction leaves holes, and a generator fills them with geometry that does not match the images. ReconViaGen places reconstruction priors inside a diffusion generator, so the completed shape and texture stay consistent with the observed views.}
}
